{
  "info": {
    "_postman_id": "8f8e50a5-7e64-4c0a-9e5c-5c1a2d3f4b60",
    "name": "Library API",
    "description": "Pengujian endpoint Library API untuk health check, members, books, dan loans.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    },
    {
      "key": "loanId",
      "value": "",
